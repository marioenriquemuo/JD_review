        "mode": "runOnceForEachItem",
        "jsCode": "function fileFor(id) {\n  let a = 2166136261, b = 2166136261;\n  for (let i = 0; i < id.length; i++) {\n    const c = id.charCodeAt(i);\n    a ^= c; a = Math.imul(a, 16777619);\n    b ^= c; b = Math.imul(b, 2246822519);\n  }\n  return (a >>> 0).toString(16).padStart(8, '0') + (b >>> 0).toString(16).padStart(8, '0') + '.json';\n}\nfunction decode(data) {\n  const pad = String(data).replace(/-/g, '+').replace(/_/g, '/');\n  return Buffer.from(pad, 'base64').toString('utf8');\n}\nfunction htmlFrom(msg) {\n  if (msg.html) return String(msg.html);\n  if (msg.textHtml) return String(msg.textHtml);\n  const chunks = [];\n  function walk(part) {\n    if (!part) return;\n    if (part.mimeType === 'text/html' && part.body && part.body.data) chunks.push(part.body.data);\n    (part.parts || []).forEach(walk);\n  }\n  walk(msg.payload || null);\n  if (!chunks.length && msg.payload && msg.payload.body && msg.payload.body.data) chunks.push(msg.payload.body.data);\n  if (chunks.length) return decode(chunks[0]);\n  return String(msg.text || msg.snippet || '');\n}\nfunction dateFrom(msg) {\n  if (msg.internalDate) return new Date(Number(msg.internalDate)).toISOString();\n  const headers = (msg.payload && msg.payload.headers) || [];\n  const row = headers.find((h) => String(h.name || '').toLowerCase() === 'date');\n  return row ? row.value : '';\n}\nconst msg = $input.item.json;\nconst id = String(msg.id || '');\nconst html = htmlFrom(msg);\nconst date = dateFrom(msg);\nfunction who(from) {\n  if (!from) return '';\n  if (typeof from === 'string') return from;\n  const addr = from.emailAddress || (from.value && from.value[0]) || from;\n  return String(addr.address || from.text || '');\n}\nconst payload = JSON.stringify({ id: id, box: 'gmail', html: html, date: date, subject: String(msg.subject || ''), from: who(msg.from) });\nconst file = fileFor(id);\nreturn { json: { id: id, box: 'gmail', file: file }, binary: { data: { data: Buffer.from(payload, 'utf8').toString('base64'), mimeType: 'application/json', fileName: file } } };\n"
