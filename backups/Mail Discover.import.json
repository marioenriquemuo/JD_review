        "jsCode": "const raw = String($json.stdout || '').trim();\nconst err = String($json.stderr || '').trim();\nif (Number($json.code || 0) !== 0) {\n  throw new Error('discover_mail.py exited ' + $json.code + ': ' + err.slice(-500));\n}\nif (!raw) {\n  if (err) throw new Error(err);\n  return [];\n}\nconst items = [];\nfor (const line of raw.split(/\\n/)) {\n  const trimmed = line.trim();\n  if (!trimmed) continue;\n  let parsed;\n  try {\n    parsed = JSON.parse(trimmed);\n  } catch (e) {\n    throw new Error(err || ('discover_mail.py returned no JSON. stdout=' + raw.slice(0, 200)));\n  }\n  items.push({\n    json: {\n      id: String(parsed.id || ''),\n      box: String(parsed.box || ''),\n      mark: parsed.mark === true,\n      added: Number(parsed.added || 0),\n    },\n  });\n}\nif (!items.length) {\n  throw new Error(err || ('discover_mail.py returned no JSON. stdout=' + raw.slice(0, 200)));\n}\nreturn items;\n"
