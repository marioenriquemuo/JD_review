{
  "manifest_version": 3,
  "name": "JD Flow Ingest",
  "version": "1.2.1",
  "description": "Send a job posting (HTML tab or PDF) to the local n8n JD Flow webhook.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send job to n8n",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5678/*",
    "http://127.0.0.1:5678/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
