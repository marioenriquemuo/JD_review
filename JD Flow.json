      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const DROP = ['script','style','svg','nav','footer','header','noscript','iframe','form','button'];\nfunction dropBlocks(html) {\n  let s = String(html || '');\n  for (let i = 0; i < DROP.length; i++) {\n    const t = DROP[i];\n    s = s.replace(new RegExp('<' + t + '\\\\b[\\\\s\\\\S]*?<\\\\/' + t + '>', 'gi'), '');\n    s = s.replace(new RegExp('<' + t + '\\\\b[^>]*\\\\/?>', 'gi'), '');\n  }\n  return s;\n}\nfunction htmlToMd(html) {\n  let s = dropBlocks(html);\n  s = s.replace(/<br\\s*\\/?>/gi, '\\n');\n  s = s.replace(/<\\/p>/gi, '\\n\\n');\n  s = s.replace(/<\\/div>/gi, '\\n');\n  s = s.replace(/<\\/li>/gi, '\\n');\n  s = s.replace(/<h1[^>]*>/gi, '\\n# ');\n  s = s.replace(/<\\/h1>/gi, '\\n');\n  s = s.replace(/<h2[^>]*>/gi, '\\n## ');\n  s = s.replace(/<\\/h2>/gi, '\\n');\n  s = s.replace(/<h3[^>]*>/gi, '\\n### ');\n  s = s.replace(/<\\/h3>/gi, '\\n');\n  s = s.replace(/<(strong|b)[^>]*>/gi, '**');\n  s = s.replace(/<\\/(strong|b)>/gi, '**');\n  s = s.replace(/<(em|i)[^>]*>/gi, '*');\n  s = s.replace(/<\\/(em|i)>/gi, '*');\n  s = s.replace(/<li[^>]*>/gi, '- ');\n  s = s.replace(/<[^>]+>/g, '');\n  s = s.replace(/&nbsp;/g, ' ');\n  s = s.replace(/&amp;/g, '&');\n  s = s.replace(/&lt;/g, '<');\n  s = s.replace(/&gt;/g, '>');\n  s = s.replace(/&quot;/g, '\"');\n  s = s.replace(/&#39;/g, \"'\");\n  s = s.replace(/[ \\t]+\\n/g, '\\n');\n  s = s.replace(/\\n{3,}/g, '\\n\\n');\n  return s.trim();\n}\nconst j = $input.item.json;\nreturn { json: { url: j.url || '', clean_md: htmlToMd(j.html || j.content || '') } };"
