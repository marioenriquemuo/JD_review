    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function cap(s) {\n  s = String(s || '');\n  return s.length <= 1900 ? s : s.slice(0, 1899) + '\\u2026';\n}\nfunction asText(value) {\n  if (value == null) return '';\n  if (typeof value === 'string') return value;\n  if (Array.isArray(value)) {\n    return value.map(function (x) {\n      if (typeof x === 'string') return '- ' + x;\n      const q = x.question || x.q || '';\n      const a = x.answer || x.a || '';\n      return 'Q: ' + q + '\\nA: ' + a;\n    }).join('\\n\\n');\n  }\n  if (typeof value === 'object') {\n    const parts = [];\n    Object.keys(value).forEach(function (k) {\n      parts.push('## ' + k);\n      parts.push(asText(value[k]));\n    });\n    return parts.join('\\n\\n');\n  }\n  return String(value);\n}\nconst item = $input.item.json;\nconst content = item.content;\nconst textBlock = Array.isArray(content) ? content.find(function (b) { return b && b.type === 'text' && b.text; }) : null;\nconst text = (textBlock && textBlock.text) || '';\nconst match = String(text).match(/\\{[\\s\\S]*\\}/);\nif (!match) throw new Error('Sonnet did not return JSON');\nconst parsed = JSON.parse(match[0]);\nconst prev = $('Flatten Style').first().json;\nconst flag = parsed.salary_flag === 'extracted' ? 'extracted' : 'UNVERIFIED Estimate';\nreturn { json: {\n  url: prev.url,\n  job_title: prev.job_title,\n  company: prev.company,\n  skills: prev.skills,\n  location: prev.location,\n  fit_score: prev.fit_score,\n  rationale: prev.rationale,\n  cv_bullets: cap(asText(parsed.cv_bullets)),\n  cover_letter: cap(asText(parsed.cover_letter)),\n  flashcards: cap(asText(parsed.flashcards)),\n  dossier: cap(asText(parsed.dossier)),\n  salary_range: parsed.salary_range || 'UNVERIFIED Estimate',\n  salary_flag: flag\n} };\n"
      },
