        "jsCode": "function blockText(j) {\n  if (!j) return '';\n  if (typeof j.content === 'string') return j.content;\n  if (typeof j.textContent === 'string') return j.textContent;\n  if (typeof j.plain_text === 'string') return j.plain_text;\n  const keys = ['paragraph','heading_1','heading_2','heading_3','bulleted_list_item','numbered_list_item','quote','code','toggle','callout'];\n  for (const k of keys) {\n    const b = j[k];\n    if (b && Array.isArray(b.rich_text)) {\n      return b.rich_text.map(function (t) { return t.plain_text || ''; }).join('');\n    }\n  }\n  if (Array.isArray(j.rich_text)) {\n    return j.rich_text.map(function (t) { return t.plain_text || ''; }).join('');\n  }\n  return '';\n}\nconst cv_md = $input.all().map(function (i) { return blockText(i.json); }).filter(Boolean).join('\\n');\nconst prev = $('Parse Clean MD').first().json;\nreturn [{ json: { url: prev.url, clean_md: prev.clean_md, cv_md: cv_md } }];\n"
